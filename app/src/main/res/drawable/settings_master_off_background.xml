<?xml version="1.0" encoding="utf-8"?>
<!--
  Master switch row, OFF state (#239): the neutral chip surface with its
  hairline, so the row reads as inactive next to the tinted ON state.
  16dp radius matches the settings cards.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/surface_chip" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_chip_stroke" />
</shape>
