<?xml version="1.0" encoding="utf-8"?>
<!--
  Master switch row, ON state (#239): a brand-tinted plate with a tinted
  hairline so the row itself reads "active", at the same 16dp radius as
  the settings cards below it. The OFF twin is
  `settings_master_off_background` (plain chip surface).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/master_on_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/master_on_stroke" />
</shape>
